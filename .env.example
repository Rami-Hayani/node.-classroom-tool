# Supabase (get from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Public browser auth config (use the same Supabase project URL and anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Flask API URL (server-side, used by Next.js API routes)
FLASK_API_URL=http://localhost:5001

# Flask API URL (client-side, used by browser fetch calls to Flask)
NEXT_PUBLIC_FLASK_API_URL=http://localhost:5001

# OpenAI (used for all AI features: extraction, questions, grading, tutoring)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Perplexity (used by resource search endpoint)
PERPLEXITY_API_KEY=pplx-...

# Demo mode (explicitly enables the transcript simulator + auto-responder)
DEMO_MODE=false

# Optional public app URL for hosted deployments
NEXT_PUBLIC_APP_URL=http://localhost:3000
